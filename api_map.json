{
  "meta": {
    "portal": "https://buyer.sukandaonelink.com/login",
    "app": "Next.js SPA (Sukanda Onelink / Diamond group)",
    "api_base": "https://api-v2.sukandaonelink.com/api/v1",
    "staging_api_base": "https://staging-api.sukandaonelink.com/api/v1",
    "discovered": "2026-11-11",
    "method": "Static analysis of all 47 JS chunks + live authenticated probing",
    "notes": "Undocumented/private API. Paths and TypeBox validation schemas were embedded in the frontend bundle (_app.js). No public OpenAPI spec exists.",
    "credentials": "Stored in .env (SUKANDA_EMAIL / SUKANDA_PASSWORD). Never commit .env."
  },
  "auth": {
    "login": {
      "method": "POST",
      "path": "/auth/login",
      "body": {
        "email": "string (email)",
        "password": "string",
        "remember": "boolean, optional",
        "subscriber": "web_buyer | web_admin | mobile  (buyer portal uses web_buyer)",
        "push_notification_token": "string, optional"
      },
      "response": {"token": "JWT (HS256)", "refresh_token": "string", "is_first_login": "boolean"},
      "verified": true
    },
    "jwt_claims": {
      "sid": "session uuid",
      "id": "user/account uuid -> used as /account/{id}",
      "role": "buyer_bill_to | buyer_ship_to (login page rejects other roles)",
      "status": "active",
      "email_status": "approved",
      "payment_method": "cash | credit",
      "iss": "sukanda_one_link",
      "sub": "web_buyer",
      "iat": "epoch seconds",
      "exp": "epoch seconds (long-lived, ~45 days)"
    },
    "refresh": {"method": "POST", "path": "/auth/refresh-token", "body": {"refresh_token": "string"}},
    "logout": {"method": "DELETE", "path": "/auth/logout"},
    "password": {
      "forgot": {"method": "POST", "path": "/auth/forgot-password"},
      "create": {"method": "POST", "path": "/auth/create-password"},
      "reset": {"method": "POST", "path": "/auth/reset-password"},
      "reset_verify": {"method": "POST", "path": "/auth/reset-password/verify"}
    },
    "required_headers": {
      "Authorization": "Bearer <token>",
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Origin": "https://buyer.sukandaonelink.com",
      "Referer": "https://buyer.sukandaonelink.com/",
      "User-Agent": "desktop Chrome UA (login returns 400 without it)",
      "X-Client-OS": "macos | windows | ...",
      "X-Client-Device": "Chrome",
      "X-Client-Version": "120.0.0.0",
      "access-control-allow-origin": "response header is pinned to https://buyer.sukandaonelink.com (CORS-enforced)"
    }
  },
  "conventions": {
    "pagination": "Most list endpoints REQUIRE size (1-100) and page (>=1). Response: {data: [...], pagination: {rows, pages}}.",
    "warehouse": "Catalog/order/promo endpoints require warehouse = ship-to UUID. Source: GET /account/{id} -> ship_tos[0].id. NOTE: GET /user/shipto returns a DIFFERENT id that does NOT work as warehouse.",
    "errors": "Ajv/TypeBox validation errors: {\"error\":\"Bad Request\",\"message\":\"querystring must have required property 'size'\",\"statusCode\":400}. Unknown routes: {\"message\":\"Route GET:/api/v1/... not found\",\"statusCode\":404}.",
    "divisions": {"diamond": "Diamond", "trading": "Trading", "fnb": "Fine Foods & Beverage (western / imported food ingredients)", "equipment": "Equipment"},
    "storages": {"dry": "Dry", "frozen": "Frozen", "dry_ac": "Dry AC", "chilled": "Chilled"},
    "sorts": ["best_seller_desc", "brand_asc", "brand_desc", "product_name_asc", "product_name_desc", "price_asc", "price_desc"],
    "order_statuses": ["draft", "submitted", "waiting_for_payment", "processed", "partially_processed", "out_for_delivery", "partially_out_for_delivery", "received", "partially_received", "cancelled"],
    "search_params": {
      "search_query": "free text (used by /product)",
      "search_by": "optional, omitted on /product",
      "order_by": "string, optional",
      "direction": "asc | desc"
    },
    "units_and_pricing": {
      "price_basis": "prices[0].price is per SALES UNIT, not per kg. Read sales_unit first: KG = price per kilogram, PC/PAC = price per piece/pack, CAR = price per carton.",
      "net_weight_trap": "net_weight / net_weight_desc describes one PIECE (e.g. 2.08 KG), which is often smaller than the sale unit (e.g. CAR = 4X2 KG). Do NOT divide price by net_weight to get Rp/kg without checking sales_unit and pack_unit.",
      "stock_magnifier": "stock is expressed in magnified units. Sale units available ~= stock / stock_magnifier (usually 1000). Example: stock=2000, stock_magnifier=1000 -> ~2 sale units left.",
      "order_quantity": "minimum_order_quantity and order_quantity_multiple are in grams for KG-sold items (2000 = 2 KG minimum) and in magnified units for PC/CAR items (1000 = 1 pack / 1 carton).",
      "stock_status_trap": "stock_status can be OUT_OF_STOCK even when stock > 0, when available stock is below minimum_order_quantity (e.g. stock 2500 vs MOQ 2750).",
      "verified_example": "Illustrative (figures removed for public distribution): a KG-sold SKU lists price P/kg with MOQ 0 and multiple 1000 (= 1 KG); its 2 KG sibling lists a slightly lower P2/kg but MOQ 2000 (minimum spend 2 x P2); a PC-sold 250 GR pack lists P3 per pack => 4 x P3 per kg. Always read sales_unit before dividing."
    },
    "catalog_sweep_duplicates": "A full GET /product sweep reports pagination.rows=2183 (22 pages x 100), but only 1856 unique item_code values: 275 codes appear twice. ALWAYS dedupe by item_code when sweeping; prefer targeted search_query for ingredient research.",
    "large_tool_results": "MCP tool results are capped at 90000 chars. Oversized list results return valid JSON with a _truncated marker (kept/total) instead of a broken string slice; page through with smaller size.",
    "sales_unit_distribution": "Across 1856 unique products: PC 805, CAR 451, KG 260, PAC 241, UN 87, BOX 5, JAR 4, BT 2, EA 1. 91 SKUs list price 0 or no price; ~5% cannot be normalized to Rp/kg (mostly equipment with unit UN/BOX).",
    "mcp_v1_1_0": {
      "structuredContent": "Every tools/call result now includes typed structuredContent plus the text block, with outputSchema declared on all 21 tools (MCP 2025-06-18). Both representations stay in sync even when truncated.",
      "compare_products": "sukanda_compare_products dedupes by item_code, normalizes Rp/kg via unit_economics(), and returns units_in_stock, minimum_order_units, minimum_spend and orderable. Zero-priced and unnormalizable SKUs sort last with an explanatory note.",
      "compact_orders": "sukanda_order_history compact=true by default strips ~40 mostly-null price-snapshot fields and image arrays, adds ISO dates, and lets an entire order history fit in one call; compact=false returns the raw payload.",
      "unit_economics": "compact_product() now embeds unit_economics() so every product result from search/get/substitutions carries normalized pricing."
    }
  },
