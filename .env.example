# Copy to .env and fill in. Never commit .env.
SUKANDA_EMAIL=you@example.com
SUKANDA_PASSWORD=your-password
SUKANDA_SUBSCRIBER=web_buyer

# Optional: ship-to UUID. If omitted, it is auto-resolved from /account/{id} -> ship_tos[0].id
SUKANDA_WAREHOUSE=

# Alternative to storing a password: supply a pre-issued JWT + refresh token instead.
# SUKANDA_TOKEN=
# SUKANDA_REFRESH_TOKEN=

# Optional override (defaults to production)
# SUKANDA_API_BASE=https://api-v2.sukandaonelink.com/api/v1
